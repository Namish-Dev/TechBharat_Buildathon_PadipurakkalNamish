{
  "manifest_version": 3,
  "name": "Inline Summarizer",
  "version": "0.2.0",
  "description": "Summarize the page, selection, or region in place without leaving the tab.",
  "permissions": ["activeTab", "scripting", "storage", "commands", "clipboardWrite"],
  "host_permissions": [
  "https://openrouter.ai/*",
  "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Summarize (Ctrl+Shift+Y)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-summarizer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open/close the summarizer panel"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}